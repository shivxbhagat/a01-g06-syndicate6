<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="comp3350.smile.presentation.Activities.HomeActivity">

    <!-- Title 'Smile' -->
    <TextView
        android:id="@+id/textViewSmile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"/>

    <!-- Search Button at top-right -->
    <ImageButton
        android:id="@+id/btnSearch"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/search_btn"
        android:contentDescription="@string/search_btn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:scaleType="fitCenter"/>

    <!-- Search Bar (Hidden Initially) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:padding="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Search Input -->
        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:hint="@string/search_ph"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:textSize="30sp"/>

        <!-- Clear Search Button (X) -->
        <ImageButton
            android:id="@+id/clearSearch"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/close"
            android:contentDescription="@string/close"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- Divider anchored to bottom of Title -->
    <View
        android:id="@+id/mainDivider"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#696969"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/textViewSmile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top Bar with Buttons -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/mainDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- For You Button -->
        <Button
            android:id="@+id/buttonForYou"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/for_you"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@android:color/darker_gray"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Saved Button -->
        <Button
            android:id="@+id/buttonSaved"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/saved"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@android:color/white"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/buttonForYou"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"/>

        <!-- My Listings Button -->
        <Button
            android:id="@+id/buttonLists"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/myListings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@android:color/white"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/buttonSaved"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"/>

        <!-- Category Button -->
        <Button
            android:id="@+id/categoryFilterButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/category"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- No Results Text (Initially Hidden) -->
    <TextView
        android:id="@+id/noResultsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/results_404"
        android:textSize="25sp"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/btnPlus"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="16dp"
        android:background="@drawable/circular_btn_bg"
        android:src="@drawable/plus"
        android:scaleType="fitXY"
        android:contentDescription="@string/fab_plus"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="15dp"/>






</androidx.constraintlayout.widget.ConstraintLayout>
