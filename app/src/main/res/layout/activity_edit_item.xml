<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@color/white">

        <!-- Top Button Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/close"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="80dp"
            android:paddingBottom="100dp"
            android:descendantFocusability="afterDescendants"
            app:layout_constraintTop_toBottomOf="@id/topButtonContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Category Image -->
                <ImageView
                    android:id="@+id/categoryImage"
                    android:layout_width="172dp"
                    android:layout_height="57dp"
                    app:srcCompat="@drawable/default_image" />

                <!-- Product Image (Not Editable) -->
                <ImageView
                    android:id="@+id/item_photo"
                    android:layout_width="match_parent"
                    android:layout_height="700dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/notes1"
                    app:layout_constraintDimensionRatio="1:1" />

                <!-- Editable Price -->
                <EditText
                    android:id="@+id/editProductPrice"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/item_price"
                    android:textSize="50sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"/>

                <!-- Editable Name -->
                <EditText
                    android:id="@+id/editProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/comp_3350_notes"
                    android:textSize="50sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>

                <!-- Category Label (Not Editable) -->
                <TextView
                    android:id="@+id/categoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_notes"
                    android:textSize="30sp"
                    android:textColor="#696969"/>

                <!-- Payment Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/paymentModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_of_payment"
                        android:textSize="30sp"
                        android:textColor="#696969"
                        android:paddingEnd="16dp"/>

                    <EditText
                        android:id="@+id/editPaymentMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/payment_mode_label"
                        android:textSize="30sp"
                        android:textColor="@color/black"
                        android:inputType="text"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_marginTop="20dp"
                    android:layout_width="200dp"
                    android:layout_height="4dp"
                    android:background="#696969"/>

                <!-- Description Label -->
                <TextView
                    android:id="@+id/descriptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/description"
                    android:textSize="45sp"
                    android:textStyle="bold"
                    android:paddingTop="12dp"/>

                <!-- Editable Description -->
                <EditText
                    android:id="@+id/editProductDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/editDesc"
                    android:textSize="30sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:inputType="textMultiLine"
                    android:maxLength="255"
                    android:minLines="3"/>

                <!-- Editable Condition -->
                <EditText
                    android:id="@+id/editProductCondition"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/condition_new"
                    android:textSize="30sp"
                    android:textColor="@color/black"
                    android:paddingTop="4dp"
                    android:inputType="text"/>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Buttons (Fixed) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/delete"
                android:textSize="20sp"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnUpdate"/>

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/update"
                android:textSize="20sp"
                android:layout_marginStart="5dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/light_blue"
                app:layout_constraintStart_toEndOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
